{
  "manifest_version": 3,
  "name": "yt-learn 擷取",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "yt-learn：把這支影片變成課程"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8765/*"
    ]
  }
}
