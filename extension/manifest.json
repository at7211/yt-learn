{
  "manifest_version": 3,
  "name": "yt-learn 擷取",
  "version": "1.3.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "timing.js",
        "intro.js",
        "overlay-state.js",
        "overlay.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "yt-learn：把這支影片變成課程"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8765/*"
    ]
  }
}
